<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/beige_bg">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="vertical"
        android:fadeScrollbars="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="18dp"
            android:paddingBottom="120dp">

            <!-- Header premium -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="18dp"
                app:cardCornerRadius="26dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="@color/navy_primary">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tv_back"
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:gravity="center"
                            android:text="‹"
                            android:textColor="@color/gold_accent"
                            android:textSize="38sp"
                            android:textStyle="bold" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:layout_marginStart="8dp">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Session stoïcienne"
                                android:textColor="@color/gold_accent"
                                android:textSize="25sp"
                                android:textStyle="bold"
                                android:fontFamily="serif" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Préparez votre esprit avant de commencer."
                                android:textColor="#E6FFFFFF"
                                android:textSize="14sp"
                                android:lineSpacingExtra="3dp"
                                android:layout_marginTop="4dp" />
                        </LinearLayout>

                    </LinearLayout>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Carte activité -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="26dp"
                app:cardElevation="3dp"
                app:cardBackgroundColor="@color/beige_card">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="22dp">

                    <TextView
                        android:id="@+id/tv_icon"
                        android:layout_width="88dp"
                        android:layout_height="88dp"
                        android:gravity="center"
                        android:text="💛"
                        android:textSize="42sp"
                        android:background="@drawable/bg_circle_gold_light" />

                    <TextView
                        android:id="@+id/tv_titre"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Respiration profonde"
                        android:textSize="28sp"
                        android:textStyle="bold"
                        android:textColor="@color/navy_primary"
                        android:fontFamily="serif"
                        android:layout_marginTop="20dp" />

                    <TextView
                        android:id="@+id/tv_description"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Prends un moment pour toi."
                        android:textSize="15sp"
                        android:textColor="@color/text_secondary"
                        android:lineSpacingExtra="4dp"
                        android:layout_marginTop="8dp" />

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Informations -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="24dp"
                app:cardElevation="3dp"
                app:cardBackgroundColor="@color/beige_card">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Informations"
                        android:textColor="@color/navy_primary"
                        android:textSize="19sp"
                        android:textStyle="bold"
                        android:fontFamily="serif"
                        android:layout_marginBottom="12dp" />

                    <TextView
                        android:id="@+id/tv_duree"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Durée estimée : 5 min"
                        android:textSize="15sp"
                        android:textColor="@color/navy_primary"
                        android:textStyle="bold"
                        android:padding="14dp"
                        android:background="@drawable/bg_edit_field" />

                    <TextView
                        android:id="@+id/tv_type"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Type : Émotionnelle"
                        android:textSize="15sp"
                        android:textColor="@color/navy_primary"
                        android:textStyle="bold"
                        android:padding="14dp"
                        android:background="@drawable/bg_edit_field"
                        android:layout_marginTop="10dp" />

                    <TextView
                        android:id="@+id/tv_plage"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Moment conseillé : Soir"
                        android:textSize="15sp"
                        android:textColor="@color/navy_primary"
                        android:textStyle="bold"
                        android:padding="14dp"
                        android:background="@drawable/bg_edit_field"
                        android:layout_marginTop="10dp" />

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Conseil -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="24dp"
                app:cardElevation="3dp"
                app:cardBackgroundColor="@color/navy_primary">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Conseil avant de commencer"
                        android:textColor="@color/gold_accent"
                        android:textSize="19sp"
                        android:textStyle="bold"
                        android:fontFamily="serif"
                        android:layout_marginBottom="10dp" />

                    <TextView
                        android:id="@+id/tv_conseil"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Commence doucement. Une petite action suffit pour avancer."
                        android:textSize="15sp"
                        android:textColor="@color/white"
                        android:lineSpacingExtra="4dp" />

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Impact -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="18dp"
                app:cardCornerRadius="24dp"
                app:cardElevation="3dp"
                app:cardBackgroundColor="@color/beige_card">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Impact attendu"
                        android:textColor="@color/navy_primary"
                        android:textSize="19sp"
                        android:textStyle="bold"
                        android:fontFamily="serif"
                        android:layout_marginBottom="10dp" />

                    <TextView
                        android:id="@+id/tv_impact"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Aide à progresser, rester concentré et améliorer ton équilibre quotidien."
                        android:textSize="15sp"
                        android:textColor="@color/text_secondary"
                        android:lineSpacingExtra="4dp" />

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <TextView
                android:id="@+id/tv_annuler"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:gravity="center"
                android:text="Annuler"
                android:textColor="@color/text_secondary"
                android:textSize="15sp"
                android:textStyle="bold" />

        </LinearLayout>
    </ScrollView>

    <!-- Bouton fixe en bas -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="92dp"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="12dp"
        android:paddingBottom="18dp"
        android:background="@color/beige_bg">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_commencer"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:text="Commencer la session"
            android:textAllCaps="false"
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="@color/navy_primary"
            app:backgroundTint="@color/gold_accent"
            app:cornerRadius="18dp"
            android:elevation="6dp" />

    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>