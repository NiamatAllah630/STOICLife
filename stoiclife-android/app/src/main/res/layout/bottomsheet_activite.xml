<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottomsheet"
    android:fillViewport="false"
    android:scrollbars="vertical"
    android:fadeScrollbars="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="22dp"
        android:paddingEnd="22dp"
        android:paddingTop="16dp"
        android:paddingBottom="28dp">

        <!-- Barre haut -->
        <View
            android:layout_width="48dp"
            android:layout_height="5dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="20dp"
            android:background="@drawable/bg_sheet_handle" />

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_marginBottom="14dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Gratitude"
                    android:textColor="@color/navy_primary"
                    android:textSize="25sp"
                    android:textStyle="bold"
                    android:fontFamily="serif" />

                <TextView
                    android:id="@+id/tv_type_duree"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="💛 Émotionnelle • 7 min"
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_marginTop="5dp" />

            </LinearLayout>

            <TextView
                android:id="@+id/btn_close"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:gravity="center"
                android:text="×"
                android:textColor="@color/navy_primary"
                android:textSize="28sp"
                android:textStyle="bold"
                android:background="@drawable/bg_close_button" />

        </LinearLayout>

        <!-- Statut -->
        <TextView
            android:id="@+id/tv_statut"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="○ Planifiée"
            android:textColor="@color/gold_accent"
            android:textSize="15sp"
            android:textStyle="bold"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:background="@drawable/bg_chip_gold_light"
            android:layout_marginBottom="18dp" />

        <!-- Description -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Description"
            android:textColor="@color/navy_primary"
            android:textSize="17sp"
            android:textStyle="bold"
            android:fontFamily="serif"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/tv_description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Noter des choses positives pour améliorer son état d’esprit."
            android:textColor="@color/text_secondary"
            android:textSize="15sp"
            android:lineSpacingExtra="4dp"
            android:padding="16dp"
            android:background="@drawable/bg_edit_field"
            android:layout_marginBottom="18dp" />

        <!-- Conseil -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Conseil stoïcien"
            android:textColor="@color/navy_primary"
            android:textSize="17sp"
            android:textStyle="bold"
            android:fontFamily="serif"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/tv_conseil"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Pendant que tu remets, la vie passe.\n— Sénèque"
            android:textColor="@color/navy_primary"
            android:textSize="15sp"
            android:textStyle="italic"
            android:lineSpacingExtra="4dp"
            android:padding="16dp"
            android:background="@drawable/bg_edit_field"
            android:layout_marginBottom="18dp" />

        <!-- Impact -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Impact attendu"
            android:textColor="@color/navy_primary"
            android:textSize="17sp"
            android:textStyle="bold"
            android:fontFamily="serif"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/tv_impact"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Améliore l’humeur, la confiance et l’état d’esprit positif."
            android:textColor="@color/text_secondary"
            android:textSize="15sp"
            android:lineSpacingExtra="4dp"
            android:padding="16dp"
            android:background="@drawable/bg_edit_field"
            android:layout_marginBottom="22dp" />

        <!-- Action principale -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_start"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Démarrer maintenant"
            android:textAllCaps="false"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/navy_primary"
            app:backgroundTint="@color/gold_accent"
            app:cornerRadius="16dp"
            android:elevation="4dp"
            android:layout_marginBottom="12dp" />

        <!-- Actions secondaires -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btn_modifier"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Modifier"
                android:textColor="@color/navy_primary"
                android:textSize="15sp"
                android:textStyle="bold"
                android:background="@drawable/bg_action_row"
                android:layout_marginEnd="8dp" />

            <TextView
                android:id="@+id/btn_supprimer"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Supprimer"
                android:textColor="@android:color/holo_red_dark"
                android:textSize="15sp"
                android:textStyle="bold"
                android:background="@drawable/bg_action_row"
                android:layout_marginStart="8dp" />

        </LinearLayout>

    </LinearLayout>
</ScrollView>