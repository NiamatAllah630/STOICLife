<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/beige_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:paddingTop="18dp"
        android:paddingBottom="34dp">

        <!-- Header premium -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="24dp"
            app:cardElevation="3dp"
            app:cardBackgroundColor="@color/navy_primary">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="22dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Planning"
                    android:textColor="@color/gold_accent"
                    android:textSize="28sp"
                    android:textStyle="bold"
                    android:fontFamily="serif" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Organisez votre journée avec discipline et sérénité."
                    android:textColor="#DDFFFFFF"
                    android:textSize="15sp"
                    android:lineSpacingExtra="4dp"
                    android:layout_marginTop="6dp" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Semaine -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="22dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="@color/beige_card">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Semaine actuelle"
                    android:textColor="@color/navy_primary"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="12dp" />

                <LinearLayout
                    android:id="@+id/ll_week_days"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Planification du jour -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="24dp"
            app:cardElevation="3dp"
            android:layout_marginBottom="16dp"
            app:cardBackgroundColor="@color/beige_card">

            <LinearLayout
                android:orientation="vertical"
                android:padding="20dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Planification du jour"
                    android:textColor="@color/navy_primary"
                    android:textSize="21sp"
                    android:textStyle="bold"
                    android:fontFamily="serif"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Touchez une période pour ajouter une activité adaptée."
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp"
                    android:layout_marginBottom="18dp" />

                <!-- MATIN -->
                <TextView
                    android:id="@+id/btn_add_matin"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:gravity="center_vertical"
                    android:text="🌅 Matin   + Ajouter une activité"
                    android:textStyle="bold"
                    android:textSize="17sp"
                    android:textColor="@color/navy_primary"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:background="@drawable/bg_planning_period" />

                <LinearLayout
                    android:id="@+id/ll_matin_activites"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginBottom="16dp" />

                <!-- JOURNEE -->
                <TextView
                    android:id="@+id/btn_add_journee"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:gravity="center_vertical"
                    android:text="☀️ Journée   + Ajouter une activité"
                    android:textStyle="bold"
                    android:textSize="17sp"
                    android:textColor="@color/navy_primary"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:background="@drawable/bg_planning_period" />

                <LinearLayout
                    android:id="@+id/ll_journee_activites"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginBottom="16dp" />

                <!-- SOIR -->
                <TextView
                    android:id="@+id/btn_add_soir"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:gravity="center_vertical"
                    android:text="🌙 Soir   + Ajouter une activité"
                    android:textStyle="bold"
                    android:textSize="17sp"
                    android:textColor="@color/navy_primary"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:background="@drawable/bg_planning_period" />

                <LinearLayout
                    android:id="@+id/ll_soir_activites"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <!-- Champs cachés pour garder compatibilité avec PlanningDAO -->
                <EditText
                    android:id="@+id/et_planning_matin"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:visibility="gone" />

                <EditText
                    android:id="@+id/et_planning_journee"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:visibility="gone" />

                <EditText
                    android:id="@+id/et_planning_soir"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:visibility="gone" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Progression premium -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="22dp"
            app:cardElevation="3dp"
            android:layout_marginBottom="16dp"
            app:cardBackgroundColor="@color/navy_primary">

            <LinearLayout
                android:orientation="horizontal"
                android:padding="18dp"
                android:gravity="center_vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:id="@+id/tv_progress_percent"
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:gravity="center"
                    android:text="0%"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="@color/navy_primary"
                    android:background="@drawable/bg_circle_gold_light" />

                <LinearLayout
                    android:orientation="vertical"
                    android:layout_marginStart="16dp"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Progression du jour"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="@color/gold_accent" />

                    <TextView
                        android:id="@+id/tv_progress_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0 / 0 activités terminées"
                        android:textColor="@color/white"
                        android:textSize="14sp"
                        android:layout_marginTop="4dp" />

                    <ProgressBar
                        android:id="@+id/pb_progress_day"
                        style="@style/Widget.AppCompat.ProgressBar.Horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="8dp"
                        android:layout_marginTop="10dp"
                        android:max="100"
                        android:progressTint="@color/gold_accent"
                        android:progressBackgroundTint="#3B4660" />
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_save_planning"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Enregistrer le planning"
            android:textSize="17sp"
            android:textStyle="bold"
            android:textAllCaps="false"
            android:textColor="@color/navy_primary"
            app:backgroundTint="@color/gold_accent"
            app:cornerRadius="16dp"
            android:elevation="4dp" />

        <LinearLayout
            android:id="@+id/ll_planning_activites"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:visibility="gone"
            android:orientation="vertical" />

    </LinearLayout>
</ScrollView>