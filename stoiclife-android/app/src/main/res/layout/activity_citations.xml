<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/beige_bg">

    <!-- Header premium -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardElevation="4dp"
        app:cardCornerRadius="0dp"
        app:cardBackgroundColor="@color/navy_primary">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="132dp"
            android:orientation="vertical"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:paddingTop="18dp"
            android:paddingBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btn_retour"
                    android:layout_width="46dp"
                    android:layout_height="46dp"
                    android:gravity="center"
                    android:text="‹"
                    android:textColor="@color/gold_accent"
                    android:textSize="38sp"
                    android:textStyle="bold"
                    android:background="@drawable/bg_circle_dark" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="12dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Bibliothèque"
                        android:textColor="@color/gold_accent"
                        android:textSize="27sp"
                        android:textStyle="bold"
                        android:fontFamily="serif" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Citations stoïciennes pour nourrir votre esprit."
                        android:textColor="#E6FFFFFF"
                        android:textSize="14sp"
                        android:layout_marginTop="3dp" />

                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- Filtres premium -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="76dp"
        android:scrollbars="none"
        android:background="@color/beige_bg"
        android:paddingStart="14dp"
        android:paddingEnd="14dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_filtre_tous"
                android:layout_width="wrap_content"
                android:layout_height="46dp"
                android:minWidth="92dp"
                android:text="Tous"
                android:textAllCaps="false"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/navy_primary"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:layout_marginEnd="10dp"
                app:cornerRadius="24dp"
                app:backgroundTint="@color/gold_accent"
                app:strokeWidth="0dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_filtre_marc"
                android:layout_width="wrap_content"
                android:layout_height="46dp"
                android:minWidth="124dp"
                android:text="Marc Aurèle"
                android:textAllCaps="false"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/navy_primary"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:layout_marginEnd="10dp"
                app:cornerRadius="24dp"
                app:backgroundTint="@color/beige_card"
                app:strokeWidth="1dp"
                app:strokeColor="@color/border_light" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_filtre_epictete"
                android:layout_width="wrap_content"
                android:layout_height="46dp"
                android:minWidth="112dp"
                android:text="Épictète"
                android:textAllCaps="false"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/navy_primary"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:layout_marginEnd="10dp"
                app:cornerRadius="24dp"
                app:backgroundTint="@color/beige_card"
                app:strokeWidth="1dp"
                app:strokeColor="@color/border_light" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_filtre_seneque"
                android:layout_width="wrap_content"
                android:layout_height="46dp"
                android:minWidth="112dp"
                android:text="Sénèque"
                android:textAllCaps="false"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/navy_primary"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:layout_marginEnd="10dp"
                app:cornerRadius="24dp"
                app:backgroundTint="@color/beige_card"
                app:strokeWidth="1dp"
                app:strokeColor="@color/border_light" />

        </LinearLayout>
    </HorizontalScrollView>

    <!-- Liste citations -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="vertical"
        android:fadeScrollbars="false">

        <LinearLayout
            android:id="@+id/ll_citations"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="4dp"
            android:paddingBottom="30dp" />

    </ScrollView>

</LinearLayout>