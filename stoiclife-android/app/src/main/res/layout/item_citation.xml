<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="14dp"
    app:cardCornerRadius="22dp"
    app:cardElevation="3dp"
    app:cardBackgroundColor="@color/beige_card">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp">

        <TextView
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:gravity="center"
            android:text="❝"
            android:textColor="@color/navy_primary"
            android:textSize="30sp"
            android:textStyle="bold"
            android:background="@drawable/bg_circle_gold_light"
            android:layout_marginBottom="14dp" />

        <TextView
            android:id="@+id/tv_citation_texte"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="« Citation »"
            android:textColor="@color/navy_primary"
            android:textSize="20sp"
            android:textStyle="italic"
            android:lineSpacingExtra="6dp"
            android:layout_marginBottom="16dp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/border_light"
            android:layout_marginBottom="14dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tv_citation_auteur"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="— Marc Aurèle"
                android:textColor="@color/gold_accent"
                android:textStyle="bold"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/btn_partager_citation"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:gravity="center"
                android:text="↗"
                android:textColor="@color/navy_primary"
                android:textSize="22sp"
                android:textStyle="bold"
                android:background="@drawable/bg_close_button" />

        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>