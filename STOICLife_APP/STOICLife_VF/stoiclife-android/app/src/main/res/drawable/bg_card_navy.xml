<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <!-- Fond -->
    <solid android:color="#1A2744" />

    <!-- Coins arrondis -->
    <corners android:radius="20dp" />

    <!-- Bordure légère -->
    <stroke
        android:width="1dp"
        android:color="#33FFFFFF"/>

    <!-- Padding interne -->
    <padding
        android:left="12dp"
        android:top="12dp"
        android:right="12dp"
        android:bottom="12dp"/>

</shape>