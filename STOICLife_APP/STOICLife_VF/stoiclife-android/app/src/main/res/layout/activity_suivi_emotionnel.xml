<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/beige_bg"
    android:fillViewport="true"
    android:scrollbars="vertical"
    android:fadeScrollbars="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Header premium -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardElevation="4dp"
            app:cardCornerRadius="0dp"
            app:cardBackgroundColor="@color/navy_primary">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="132dp"
                android:orientation="vertical"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:paddingTop="18dp"
                android:paddingBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/btn_retour_emotion"
                        android:layout_width="46dp"
                        android:layout_height="46dp"
                        android:gravity="center"
                        android:text="‹"
                        android:textColor="@color/gold_accent"
                        android:textSize="38sp"
                        android:textStyle="bold"
                        android:background="@drawable/bg_circle_dark" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="12dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Suivi émotionnel"
                            android:textColor="@color/gold_accent"
                            android:textSize="27sp"
                            android:textStyle="bold"
                            android:fontFamily="serif" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Comprenez votre humeur et prenez soin de votre équilibre."
                            android:textColor="#E6FFFFFF"
                            android:textSize="14sp"
                            android:layout_marginTop="3dp" />

                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Contenu -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="16dp"
            android:paddingBottom="34dp">

            <!-- Carte humeur -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="24dp"
                app:cardElevation="3dp"
                app:cardBackgroundColor="@color/beige_card">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <TextView
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        android:gravity="center"
                        android:text="🙂"
                        android:textSize="25sp"
                        android:background="@drawable/bg_circle_gold_light"
                        android:layout_marginBottom="12dp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Comment te sens-tu aujourd’hui ?"
                        android:textColor="@color/navy_primary"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:fontFamily="serif"
                        android:layout_marginBottom="6dp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Choisissez votre humeur actuelle pour mieux comprendre votre état intérieur."
                        android:textColor="@color/text_secondary"
                        android:textSize="14sp"
                        android:lineSpacingExtra="3dp"
                        android:layout_marginBottom="16dp" />

                    <HorizontalScrollView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:scrollbars="none">

                        <RadioGroup
                            android:id="@+id/rg_humeur"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <RadioButton
                                android:id="@+id/rb_calme"
                                android:layout_width="wrap_content"
                                android:layout_height="54dp"
                                android:text="😌  Calme"
                                android:textColor="@color/navy_primary"
                                android:textSize="15sp"
                                android:textStyle="bold"
                                android:button="@null"
                                android:gravity="center"
                                android:paddingStart="18dp"
                                android:paddingEnd="18dp"
                                android:layout_marginEnd="10dp"
                                android:background="@drawable/bg_emotion_chip" />

                            <RadioButton
                                android:id="@+id/rb_stresse"
                                android:layout_width="wrap_content"
                                android:layout_height="54dp"
                                android:text="😟  Stressé"
                                android:textColor="@color/navy_primary"
                                android:textSize="15sp"
                                android:textStyle="bold"
                                android:button="@null"
                                android:gravity="center"
                                android:paddingStart="18dp"
                                android:paddingEnd="18dp"
                                android:layout_marginEnd="10dp"
                                android:background="@drawable/bg_emotion_chip" />

                            <RadioButton
                                android:id="@+id/rb_triste"
                                android:layout_width="wrap_content"
                                android:layout_height="54dp"
                                android:text="😔  Triste"
                                android:textColor="@color/navy_primary"
                                android:textSize="15sp"
                                android:textStyle="bold"
                                android:button="@null"
                                android:gravity="center"
                                android:paddingStart="18dp"
                                android:paddingEnd="18dp"
                                android:layout_marginEnd="10dp"
                                android:background="@drawable/bg_emotion_chip" />

                            <RadioButton
                                android:id="@+id/rb_motive"
                                android:layout_width="wrap_content"
                                android:layout_height="54dp"
                                android:text="🔥  Motivé"
                                android:textColor="@color/navy_primary"
                                android:textSize="15sp"
                                android:textStyle="bold"
                                android:button="@null"
                                android:gravity="center"
                                android:paddingStart="18dp"
                                android:paddingEnd="18dp"
                                android:layout_marginEnd="10dp"
                                android:background="@drawable/bg_emotion_chip" />

                            <RadioButton
                                android:id="@+id/rb_fatigue"
                                android:layout_width="wrap_content"
                                android:layout_height="54dp"
                                android:text="😴  Fatigué"
                                android:textColor="@color/navy_primary"
                                android:textSize="15sp"
                                android:textStyle="bold"
                                android:button="@null"
                                android:gravity="center"
                                android:paddingStart="18dp"
                                android:paddingEnd="18dp"
                                android:layout_marginEnd="10dp"
                                android:background="@drawable/bg_emotion_chip" />

                        </RadioGroup>
                    </HorizontalScrollView>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Intensité -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="24dp"
                app:cardElevation="3dp"
                app:cardBackgroundColor="@color/beige_card">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Intensité émotionnelle"
                            android:textColor="@color/navy_primary"
                            android:textSize="19sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tv_intensite_value"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="3 / 5"
                            android:textColor="@color/gold_accent"
                            android:textSize="18sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <SeekBar
                        android:id="@+id/seek_intensite"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:max="4"
                        android:progress="2"
                        android:progressTint="@color/gold_accent"
                        android:thumbTint="@color/gold_accent"
                        android:layout_marginTop="12dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="2dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Faible"
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Forte"
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp"
                            android:gravity="end" />
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Déclencheurs -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="24dp"
                app:cardElevation="3dp"
                app:cardBackgroundColor="@color/beige_card">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Déclencheur principal"
                        android:textColor="@color/navy_primary"
                        android:textSize="19sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="12dp" />

                    <HorizontalScrollView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:scrollbars="none">

                        <RadioGroup
                            android:id="@+id/rg_declencheur"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <RadioButton
                                android:id="@+id/rb_etudes"
                                android:layout_width="wrap_content"
                                android:layout_height="46dp"
                                android:text="Études"
                                android:textColor="@color/navy_primary"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                android:button="@null"
                                android:gravity="center"
                                android:paddingStart="18dp"
                                android:paddingEnd="18dp"
                                android:layout_marginEnd="10dp"
                                android:background="@drawable/bg_emotion_chip" />

                            <RadioButton
                                android:id="@+id/rb_projet"
                                android:layout_width="wrap_content"
                                android:layout_height="46dp"
                                android:text="Projet"
                                android:textColor="@color/navy_primary"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                android:button="@null"
                                android:gravity="center"
                                android:paddingStart="18dp"
                                android:paddingEnd="18dp"
                                android:layout_marginEnd="10dp"
                                android:background="@drawable/bg_emotion_chip" />

                            <RadioButton
                                android:id="@+id/rb_famille"
                                android:layout_width="wrap_content"
                                android:layout_height="46dp"
                                android:text="Famille"
                                android:textColor="@color/navy_primary"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                android:button="@null"
                                android:gravity="center"
                                android:paddingStart="18dp"
                                android:paddingEnd="18dp"
                                android:layout_marginEnd="10dp"
                                android:background="@drawable/bg_emotion_chip" />

                            <RadioButton
                                android:id="@+id/rb_sommeil"
                                android:layout_width="wrap_content"
                                android:layout_height="46dp"
                                android:text="Sommeil"
                                android:textColor="@color/navy_primary"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                android:button="@null"
                                android:gravity="center"
                                android:paddingStart="18dp"
                                android:paddingEnd="18dp"
                                android:layout_marginEnd="10dp"
                                android:background="@drawable/bg_emotion_chip" />

                            <RadioButton
                                android:id="@+id/rb_telephone"
                                android:layout_width="wrap_content"
                                android:layout_height="46dp"
                                android:text="Téléphone"
                                android:textColor="@color/navy_primary"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                android:button="@null"
                                android:gravity="center"
                                android:paddingStart="18dp"
                                android:paddingEnd="18dp"
                                android:layout_marginEnd="10dp"
                                android:background="@drawable/bg_emotion_chip" />
                        </RadioGroup>
                    </HorizontalScrollView>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Coach -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="24dp"
                app:cardElevation="3dp"
                app:cardBackgroundColor="@color/navy_primary">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="18dp">

                    <TextView
                        android:layout_width="50dp"
                        android:layout_height="50dp"
                        android:gravity="center"
                        android:text="🧠"
                        android:textSize="26sp"
                        android:background="@drawable/bg_circle_gold_light" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="14dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Coach STOICLife"
                            android:textColor="@color/gold_accent"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:fontFamily="serif" />

                        <TextView
                            android:id="@+id/tv_recommandation"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Recommandation : choisissez votre humeur pour recevoir un conseil personnalisé."
                            android:textColor="@color/white"
                            android:textSize="15sp"
                            android:lineSpacingExtra="4dp"
                            android:layout_marginTop="4dp" />
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Note personnelle -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Note personnelle"
                android:textColor="@color/navy_primary"
                android:textSize="21sp"
                android:textStyle="bold"
                android:fontFamily="serif"
                android:layout_marginBottom="8dp" />

            <EditText
                android:id="@+id/et_note_emotion"
                android:layout_width="match_parent"
                android:layout_height="140dp"
                android:hint="Écrivez une petite note sur votre ressenti..."
                android:textColor="@color/white"
                android:textColorHint="#C9C9C9"
                android:textSize="16sp"
                android:gravity="top"
                android:padding="18dp"
                android:background="@drawable/bg_emotion_textarea"
                android:inputType="textMultiLine"
                android:layout_marginBottom="16dp" />

            <!-- Bouton enregistrer -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_enregistrer_emotion"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:text="Enregistrer le suivi"
                android:textSize="17sp"
                android:textStyle="bold"
                android:textAllCaps="false"
                app:cornerRadius="18dp"
                app:backgroundTint="@color/gold_accent"
                android:textColor="@color/navy_primary"
                android:layout_marginBottom="22dp" />

            <!-- Historique -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Historique émotionnel"
                android:textColor="@color/navy_primary"
                android:textStyle="bold"
                android:textSize="22sp"
                android:fontFamily="serif"
                android:layout_marginBottom="12dp" />

            <LinearLayout
                android:id="@+id/ll_historique_emotions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

        </LinearLayout>
    </LinearLayout>
</ScrollView>