<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/card_activity"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="20dp"
    app:cardElevation="3dp"
    app:cardBackgroundColor="@color/beige_card">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tv_act_icon"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:gravity="center"
            android:text="🧠"
            android:textSize="24sp"
            android:background="@drawable/bg_activity_icon_premium" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="14dp">

            <TextView
                android:id="@+id/tv_act_titre"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Lecture stoïcienne"
                android:textColor="@color/navy_primary"
                android:textStyle="bold"
                android:textSize="17sp" />

            <TextView
                android:id="@+id/tv_act_type"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="mentale • 15 min"
                android:textColor="@color/text_secondary"
                android:textSize="14sp"
                android:layout_marginTop="4dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_act_statut"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:gravity="center"
            android:paddingStart="13dp"
            android:paddingEnd="13dp"
            android:text="○ Planifiée"
            android:textColor="@color/gold_accent"
            android:textSize="13sp"
            android:textStyle="bold"
            android:background="@drawable/bg_status_pill_premium" />

    </LinearLayout>
</androidx.cardview.widget.CardView>