<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="22dp"
    app:cardElevation="3dp"
    app:cardBackgroundColor="@color/beige_card">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/tv_emotion_emoji"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:gravity="center"
            android:text="🙂"
            android:textSize="28sp"
            android:background="@drawable/bg_circle_gold_light" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="14dp">

            <TextView
                android:id="@+id/tv_emotion_titre"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Calme · 2026-05-19"
                android:textColor="@color/gold_accent"
                android:textSize="15sp"
                android:textStyle="bold"
                android:layout_marginBottom="5dp" />

            <TextView
                android:id="@+id/tv_emotion_details"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Intensité : 3/5 · Déclencheur : Projet"
                android:textColor="@color/navy_primary"
                android:textSize="14sp"
                android:textStyle="bold"
                android:lineSpacingExtra="3dp"
                android:layout_marginBottom="5dp" />

            <TextView
                android:id="@+id/tv_emotion_note"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Note..."
                android:textColor="@color/text_secondary"
                android:textSize="14sp"
                android:lineSpacingExtra="3dp"
                android:maxLines="3"
                android:ellipsize="end" />

        </LinearLayout>

        <TextView
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:gravity="center"
            android:text="›"
            android:textColor="@color/gold_accent"
            android:textSize="28sp"
            android:textStyle="bold" />

    </LinearLayout>
</androidx.cardview.widget.CardView>