<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/card_planning_item"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    android:layout_marginBottom="6dp"
    app:cardCornerRadius="18dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="#FFFDF8">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="14dp">

        <TextView
            android:id="@+id/tv_plan_icon"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:gravity="center"
            android:text="🧠"
            android:textSize="23sp"
            android:background="@drawable/bg_activity_icon_premium" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="13dp">

            <TextView
                android:id="@+id/tv_plan_titre"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Lecture stoïcienne"
                android:textColor="@color/navy_primary"
                android:textSize="16sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/tv_plan_info"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Mentale • 15 min"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                android:layout_marginTop="3dp" />

        </LinearLayout>

        <TextView
            android:id="@+id/tv_plan_statut"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:gravity="center"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="Planifiée"
            android:textColor="@color/gold_accent"
            android:textSize="12sp"
            android:textStyle="bold"
            android:background="@drawable/bg_status_pill_premium" />

    </LinearLayout>
</androidx.cardview.widget.CardView>