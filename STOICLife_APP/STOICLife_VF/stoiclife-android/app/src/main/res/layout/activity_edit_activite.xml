<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/beige_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:paddingTop="18dp"
        android:paddingBottom="36dp">

        <!-- Header premium -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btn_back_edit"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:gravity="center"
                android:text="‹"
                android:textSize="36sp"
                android:textStyle="bold"
                android:textColor="@color/gold_accent"
                android:background="@drawable/bg_circle_gold_light" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Modifier l’activité"
                android:textColor="@color/navy_primary"
                android:textSize="24sp"
                android:textStyle="bold"
                android:fontFamily="serif"
                android:gravity="center" />

            <Space
                android:layout_width="46dp"
                android:layout_height="46dp" />
        </LinearLayout>

        <!-- Carte formulaire -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            app:cardCornerRadius="24dp"
            app:cardElevation="3dp"
            app:cardBackgroundColor="@color/beige_card">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="22dp">

                <!-- Petit texte -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Ajustez les informations de votre activité."
                    android:textColor="@color/text_secondary"
                    android:textSize="15sp"
                    android:lineSpacingExtra="4dp"
                    android:layout_marginBottom="18dp" />

                <!-- Type -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Type d’activité"
                    android:textColor="@color/navy_primary"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="7dp" />

                <Spinner
                    android:id="@+id/sp_edit_type"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:background="@drawable/bg_edit_field"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:layout_marginBottom="14dp" />

                <!-- Activité proposée -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Activité proposée"
                    android:textColor="@color/navy_primary"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="7dp" />

                <Spinner
                    android:id="@+id/sp_edit_activite"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:background="@drawable/bg_edit_field"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:layout_marginBottom="14dp" />

                <!-- Titre -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Titre personnalisé"
                    android:textColor="@color/navy_primary"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="7dp" />

                <EditText
                    android:id="@+id/et_edit_titre"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:hint="Titre de l’activité"
                    android:inputType="textNoSuggestions"
                    android:textColor="@color/navy_primary"
                    android:textColorHint="#887C6F"
                    android:textSize="16sp"
                    android:singleLine="true"
                    android:background="@drawable/bg_edit_field"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:layout_marginBottom="14dp" />

                <!-- Description -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Description"
                    android:textColor="@color/navy_primary"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="7dp" />

                <EditText
                    android:id="@+id/et_edit_description"
                    android:layout_width="match_parent"
                    android:layout_height="130dp"
                    android:hint="Décrivez l’activité..."
                    android:inputType="textMultiLine|textNoSuggestions"
                    android:textColor="@color/navy_primary"
                    android:textColorHint="#887C6F"
                    android:textSize="16sp"
                    android:gravity="top"
                    android:background="@drawable/bg_edit_field"
                    android:padding="16dp"
                    android:layout_marginBottom="14dp" />

                <!-- Durée -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Durée"
                    android:textColor="@color/navy_primary"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="7dp" />

                <EditText
                    android:id="@+id/et_edit_duree"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:hint="Durée en minutes"
                    android:inputType="number"
                    android:textColor="@color/navy_primary"
                    android:textColorHint="#887C6F"
                    android:textSize="16sp"
                    android:background="@drawable/bg_edit_field"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Bouton enregistrer -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_save_edit"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="18dp"
            android:text="Enregistrer les modifications"
            android:textColor="@color/navy_primary"
            android:textSize="17sp"
            android:textStyle="bold"
            android:textAllCaps="false"
            app:backgroundTint="@color/gold_accent"
            app:cornerRadius="16dp" />

    </LinearLayout>
</ScrollView>