<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/beige_bg">

    <!-- Header premium -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardElevation="4dp"
        app:cardCornerRadius="0dp"
        app:cardBackgroundColor="@color/navy_primary">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="132dp"
            android:orientation="vertical"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:paddingTop="18dp"
            android:paddingBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btn_retour_journal"
                    android:layout_width="46dp"
                    android:layout_height="46dp"
                    android:gravity="center"
                    android:text="‹"
                    android:textColor="@color/gold_accent"
                    android:textSize="38sp"
                    android:textStyle="bold"
                    android:background="@drawable/bg_circle_dark" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="12dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Journal stoïcien"
                        android:textColor="@color/gold_accent"
                        android:textSize="27sp"
                        android:textStyle="bold"
                        android:fontFamily="serif" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Écrivez, clarifiez et avancez avec sérénité."
                        android:textColor="#E6FFFFFF"
                        android:textSize="14sp"
                        android:layout_marginTop="3dp" />

                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- Catégories -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="76dp"
        android:background="@color/beige_bg"
        android:scrollbars="none"
        android:paddingStart="14dp"
        android:paddingEnd="14dp">

        <RadioGroup
            android:id="@+id/rg_prompt_type"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <RadioButton
                android:id="@+id/rb_intention"
                android:layout_width="wrap_content"
                android:layout_height="46dp"
                android:text="☀️  Intention"
                android:textColor="@color/navy_primary"
                android:textSize="15sp"
                android:textStyle="bold"
                android:button="@null"
                android:background="@drawable/bg_journal_chip"
                android:gravity="center"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:layout_marginEnd="10dp"
                android:checked="true" />

            <RadioButton
                android:id="@+id/rb_bilan"
                android:layout_width="wrap_content"
                android:layout_height="46dp"
                android:text="🌙  Bilan"
                android:textColor="@color/navy_primary"
                android:textSize="15sp"
                android:textStyle="bold"
                android:button="@null"
                android:background="@drawable/bg_journal_chip"
                android:gravity="center"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:layout_marginEnd="10dp" />

            <RadioButton
                android:id="@+id/rb_gratitude"
                android:layout_width="wrap_content"
                android:layout_height="46dp"
                android:text="♡  Gratitude"
                android:textColor="@color/navy_primary"
                android:textSize="15sp"
                android:textStyle="bold"
                android:button="@null"
                android:background="@drawable/bg_journal_chip"
                android:gravity="center"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:layout_marginEnd="10dp" />

            <RadioButton
                android:id="@+id/rb_discipline"
                android:layout_width="wrap_content"
                android:layout_height="46dp"
                android:text="🎯  Discipline"
                android:textColor="@color/navy_primary"
                android:textSize="15sp"
                android:textStyle="bold"
                android:button="@null"
                android:background="@drawable/bg_journal_chip"
                android:gravity="center"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:layout_marginEnd="10dp" />

            <RadioButton
                android:id="@+id/rb_libre"
                android:layout_width="wrap_content"
                android:layout_height="46dp"
                android:text="✍️  Libre"
                android:textColor="@color/navy_primary"
                android:textSize="15sp"
                android:textStyle="bold"
                android:button="@null"
                android:background="@drawable/bg_journal_chip"
                android:gravity="center"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:layout_marginEnd="10dp" />

        </RadioGroup>
    </HorizontalScrollView>

    <!-- Contenu -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="vertical"
        android:fadeScrollbars="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="4dp"
            android:paddingBottom="34dp">

            <!-- Question guidée -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="24dp"
                app:cardElevation="3dp"
                app:cardBackgroundColor="@color/beige_card">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <TextView
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        android:gravity="center"
                        android:text="❔"
                        android:textSize="24sp"
                        android:background="@drawable/bg_circle_gold_light"
                        android:layout_marginBottom="12dp" />

                    <TextView
                        android:id="@+id/tv_prompt_guide"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Quelles sont mes intentions pour aujourd’hui ?"
                        android:textColor="@color/navy_primary"
                        android:textSize="19sp"
                        android:textStyle="bold"
                        android:lineSpacingExtra="5dp"
                        android:layout_marginBottom="14dp" />

                    <TextView
                        android:id="@+id/btn_question_suivante"
                        android:layout_width="wrap_content"
                        android:layout_height="42dp"
                        android:gravity="center"
                        android:text="Question suivante  →"
                        android:textColor="@color/gold_accent"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp" />

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Zone d'écriture -->
            <!-- Zone d'écriture avec défilement interne -->
            <EditText
                android:id="@+id/et_journal_contenu"
                android:layout_width="match_parent"
                android:layout_height="240dp"
                android:hint="Écrivez ici votre réflexion..."
                android:textColorHint="#C9C9C9"
                android:textColor="@color/white"
                android:textSize="17sp"
                android:gravity="top|start"
                android:padding="18dp"
                android:background="@drawable/bg_journal_textarea"
                android:inputType="textMultiLine|textCapSentences"
                android:minLines="6"
                android:maxLines="10"
                android:scrollbars="vertical"
                android:fadeScrollbars="false"
                android:overScrollMode="always"
                android:isScrollContainer="true"
                android:layout_marginBottom="16dp" />

            <!-- Bouton enregistrer -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_enregistrer_journal"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:text="Enregistrer la réflexion"
                android:textSize="17sp"
                android:textStyle="bold"
                android:textAllCaps="false"
                app:cornerRadius="18dp"
                app:backgroundTint="@color/gold_accent"
                android:textColor="@color/navy_primary"
                android:layout_marginBottom="22dp" />

            <!-- Entrées précédentes -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Entrées précédentes"
                android:textColor="@color/navy_primary"
                android:textStyle="bold"
                android:textSize="22sp"
                android:fontFamily="serif"
                android:layout_marginBottom="12dp" />

            <LinearLayout
                android:id="@+id/ll_journal_entrees"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

        </LinearLayout>
    </ScrollView>

</LinearLayout>