<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    app:cardCornerRadius="20dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="@color/beige_card">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/tv_badge_icon"
            android:layout_width="58dp"
            android:layout_height="58dp"
            android:gravity="center"
            android:text="🔥"
            android:textSize="28sp"
            android:background="@drawable/bg_circle_gold_light" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="14dp">

            <TextView
                android:id="@+id/tv_badge_nom"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Première Flamme"
                android:textColor="@color/navy_primary"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_badge_desc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="1ère activité"
                android:textColor="@color/text_secondary"
                android:textSize="14sp"
                android:layout_marginTop="3dp" />

        </LinearLayout>

        <TextView
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:gravity="center"
            android:text="✓"
            android:textColor="@color/gold_accent"
            android:textSize="20sp"
            android:textStyle="bold" />

    </LinearLayout>
</androidx.cardview.widget.CardView>