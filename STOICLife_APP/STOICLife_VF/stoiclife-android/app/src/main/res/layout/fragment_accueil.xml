<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/beige_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:paddingTop="18dp"
        android:paddingBottom="22dp">

        <!-- Header premium -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="24dp"
            app:cardElevation="3dp"
            app:cardBackgroundColor="@color/navy_primary">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="22dp">

                <TextView
                    android:id="@+id/tv_date_home"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Mercredi 20 mai 2026"
                    android:textColor="#AFC0D8"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_greeting"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Bonjour, Stoïcien !"
                    android:textColor="@color/white"
                    android:textSize="27sp"
                    android:textStyle="bold"
                    android:layout_marginTop="8dp" />

                <TextView
                    android:id="@+id/tv_quote_home"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="« La discipline est la racine de toute réussite. »"
                    android:textColor="#D8D8D8"
                    android:textSize="16sp"
                    android:textStyle="italic"
                    android:lineSpacingExtra="4dp"
                    android:layout_marginTop="18dp" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Carte Progression -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            app:cardCornerRadius="22dp"
            app:cardElevation="3dp"
            app:cardBackgroundColor="@color/beige_card">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <!-- Niveau -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Niveau"
                            android:textColor="@color/text_secondary"
                            android:textSize="15sp" />

                        <TextView
                            android:id="@+id/tv_niveau"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Débutant"
                            android:textColor="@color/navy_primary"
                            android:textSize="19sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- XP -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Points XP"
                            android:textColor="@color/text_secondary"
                            android:textSize="15sp" />

                        <TextView
                            android:id="@+id/tv_xp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0 XP"
                            android:textColor="@color/gold_accent"
                            android:textSize="19sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Série -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="end">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Série"
                            android:textColor="@color/text_secondary"
                            android:textSize="15sp" />

                        <TextView
                            android:id="@+id/tv_streak"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0 jours 🔥"
                            android:textColor="@color/navy_primary"
                            android:textSize="19sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>

                <ProgressBar
                    android:id="@+id/pb_xp"
                    style="@style/Widget.AppCompat.ProgressBar.Horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="9dp"
                    android:layout_marginTop="16dp"
                    android:progressTint="@color/gold_accent"
                    android:progressBackgroundTint="@color/border_light"
                    android:progress="0"
                    android:max="100" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Carte Suivi émotionnel -->
        <androidx.cardview.widget.CardView
            android:id="@+id/card_suivi_emotionnel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            app:cardCornerRadius="22dp"
            app:cardElevation="3dp"
            app:cardBackgroundColor="@color/beige_card">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Comment te sens-tu aujourd’hui ?"
                    android:textColor="@color/navy_primary"
                    android:textSize="21sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="16dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:layout_marginBottom="16dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="😌\nCalme"
                        android:textColor="@color/navy_primary"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:gravity="center" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="😟\nStressé"
                        android:textColor="@color/navy_primary"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:gravity="center" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="🔥\nMotivé"
                        android:textColor="@color/navy_primary"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:gravity="center" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_suivre_humeur"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:text="Suivre mon humeur"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:textAllCaps="false"
                    android:textColor="@color/navy_primary"
                    app:cornerRadius="16dp"
                    app:backgroundTint="@color/gold_accent" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Coach STOICLife -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            app:cardCornerRadius="22dp"
            app:cardElevation="3dp"
            app:cardBackgroundColor="@color/navy_primary">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:gravity="center"
                    android:text="🧠"
                    android:textSize="26sp"
                    android:background="@drawable/bg_circle_gold_light" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="14dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Coach STOICLife"
                        android:textColor="@color/gold_accent"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_coach_home"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Commencez par une activité simple pour garder votre régularité."
                        android:textColor="@color/white"
                        android:textSize="15sp"
                        android:lineSpacingExtra="4dp"
                        android:layout_marginTop="4dp" />

                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Bouton Focus -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_mode_focus"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginBottom="18dp"
            android:text="🎯  Focus"
            android:textSize="17sp"
            android:textStyle="bold"
            android:textAllCaps="false"
            app:cornerRadius="16dp"
            app:backgroundTint="@color/gold_accent"
            android:textColor="@color/navy_primary" />

        <!-- Activités du jour -->
        <TextView
            android:id="@+id/tv_activites_today"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0/0 activités complétées"
            android:textColor="@color/text_secondary"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="12dp" />

        <LinearLayout
            android:id="@+id/ll_activites_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

    </LinearLayout>
</ScrollView>